<?xml version="1.0" encoding="utf-8"?>
<!--
  路径规划 (route planner) strings.

  Owned by `route-planner`. Keys are prefixed `rp_` on purpose: the legacy 路线 panel already owns
  every `route_*` key in strings.xml (`ui-maps` scope), and redefining one of those here would be a
  duplicate-resource build error. Do not add keys to this file from another workstream.
-->
<resources>

    <!-- Sheet header -->
    <string name="rp_title">路径规划</string>
    <string name="rp_subtitle">选择起终点与途经点，按道路规划路线</string>

    <!-- Fields -->
    <string name="rp_origin">起点</string>
    <string name="rp_destination">终点</string>
    <string name="rp_waypoint">途经点 %1$d</string>
    <string name="rp_add_waypoint">添加途经点</string>
    <string name="rp_remove_waypoint">删除途经点 %1$d</string>
    <string name="rp_move_up">上移 %1$d</string>
    <string name="rp_move_down">下移 %1$d</string>
    <string name="rp_current_location">当前位置</string>
    <string name="rp_use_current">设为当前位置</string>
    <string name="rp_swap">交换起点和终点</string>
    <string name="rp_tap_to_search">点击搜索地点</string>
    <string name="rp_waypoints_none">无途经点</string>

    <!-- Travel modes -->
    <string name="rp_mode_label">出行方式</string>
