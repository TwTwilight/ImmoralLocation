<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ImmoralLocation" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#FFFEFBFF</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Launch theme: the animated mark on the app's surface colour, then the normal theme. -->
    <style name="Theme.ImmoralLocation.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FFFEFBFF</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_animated</item>
        <item name="windowSplashScreenAnimationDuration">900</item>
        <item name="postSplashScreenTheme">@style/Theme.ImmoralLocation</item>
    </style>
</resources>