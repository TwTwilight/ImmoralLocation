<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon background: MD3 tonal ramp (light lavender -> deep violet) plus a
  soft top-left glow. Gradients inside a VectorDrawable need API 24+, which is
  fine here because this layer is only reachable through the -v26 adaptive icon;
  pre-26 devices get drawable/ic_launcher_legacy instead.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="84.2"
                android:endY="108"
                android:startColor="#FFA08BF2"
                android:endColor="#FF3A1F8C" />
        </aapt:attr>
    </path>

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="25.9"
                android:centerY="10.8"
                android:gradientRadius="102.6"
                android:startColor="#3DFFFFFF"
                android:endColor="#00FFFFFF" />
        </aapt:attr>
    </path>
</vector>
