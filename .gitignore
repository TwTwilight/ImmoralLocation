# Gradle / Android
.gradle/
build/
local.properties
*.hprof
captures/
.externalNativeBuild/
.cxx/

# IDE
.idea/
*.iml
.vscode/
.fleet/

# OS
.DS_Store
Thumbs.db

# Local test artifacts
artifacts/
*.log

# Device harness, probes and the verifier app stay on the box that owns the phone. They are never
# part of the repository: they need a real device, a rooted ROM and an LSPosed install, so they are
# dead weight for anyone reading the source, and CI does not run them.
e2e/out/
hook/harness/
verifier/
*.ps1
!e2e/**/*.ps1
*.psm1
*.sh
*.py

# Reverse-engineering / acceptance material: kept on disk, never published.
.lead/
apk/
docs/**
dumps/
frida/
jadx2/
jadx3/
jadx_payload/
reports/
unpacked/
web/

# Documentation beyond the README
*.md
!docs/**/*.md
!/README.md

# Native layer build outputs (libimmoralhook.so is committed prebuilt in hook/src/main/jniLibs;
# ShadowHook comes from the xmake package repo now, so there is no vendored third_party/ tree left)
native/.xmake/
native/build/
native/out/

# Signing material never leaves the machine: CI gets it from repository secrets
keystore/
*.jks
*.keystore

# Kotlin incremental build state
.kotlin/


# Agent scratch directory (plans/probes from parallel workers), never shipped
.agents/
docs/
